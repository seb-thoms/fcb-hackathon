# Local settings. Copy this file to .env and edit it; .env is gitignored, this file is committed.
#
# MTAH_DATA_DIR -- absolute path to the unpacked match bundle, the folder that contains tactical/
# and broadcast/. Leave it unset to use ./data inside the repository. A variable already set in
# your shell takes precedence over this file.
#
# Values are read literally: no escapes and no $VAR expansion, so Windows paths work as written.
# Quotes are optional and stripped.

MTAH_DATA_DIR="/absolute/path/to/data"
